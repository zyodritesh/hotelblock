<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HotelBlock" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="Theme.HotelBlock.Incoming" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
